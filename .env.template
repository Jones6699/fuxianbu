# ============================================
# API Key 配置模板
# 复制此文件为 .env 并填入你的 API Key
# ============================================

# DeepSeek（默认）
VITE_DEEPSEEK_API_KEY=sk-your-key-here
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com

# SiliconFlow（硅基流动，DeepSeek V3.2+ 等 OpenAI 兼容模型）
VITE_SILICONFLOW_API_KEY=sk-your-key-here
VITE_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# OpenAI
VITE_OPENAI_API_KEY=sk-your-key-here
VITE_OPENAI_BASE_URL=https://api.openai.com

# Anthropic (Claude)
VITE_ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google (Gemini)
VITE_GOOGLE_API_KEY=your-key-here

# ============================================
# 【需服务器】以下功能需要后端服务支持：
# ============================================

# 云端同步服务地址（可选）
VITE_SYNC_SERVER_URL=

# WebDAV 同步配置（可选）
VITE_WEBDAV_URL=
VITE_WEBDAV_USERNAME=
VITE_WEBDAV_PASSWORD=
